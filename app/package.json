{
  "name": "s3-browser-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight S3 bucket/object browser for Windows and macOS",
  "author": "cornibe",
  "main": "dist/electron/main.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/cornibe/s3-browser-lite"
  },
  "scripts": {
    "dev": "concurrently -k -n TSC,VITE,ELECTRON \"tsc -w -p tsconfig.electron.json\" \"vite --config electron.vite.ts\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build --config electron.vite.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
  "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "package": "npm run build && electron-forge package",
  "make": "npm run build && electron-forge make",
  "postinstall": "node scripts/write-icon.js",
  "build:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis msi"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
  "electron-builder": "^24.13.3",
  "electron": "^38.0.0",
  "@electron-forge/cli": "^7.8.3",
  "crc": "^4.3.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-optimizer": "^1.4.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.676.0",
    "@tanstack/react-query": "^5.59.16",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.cornibe.s3browserlite",
  "productName": "S3 Browser-lite",
  "compression": "maximum",
    "directories": {
  "output": "dist"
    },
    "files": [
  "dist/electron/**",
  "dist/renderer/**",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "executableName": "s3-browser-lite",
      "target": [
        "nsis",
        "msi"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "s3-browser-lite-Setup-${version}.${ext}"
    },
    "msi": {
      "artifactName": "s3-browser-lite-${version}.msi",
      "shortcutName": "S3 Browser-lite"
    },
    "afterSign": false,
    "publish": [
      {
        "provider": "github",
        "owner": "cornibe",
        "repo": "s3-browser-lite"
      }
    ]
  }
}
